                            "provider",
                            "id"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "source": {
                              "type": "string",
                              "const": "store"
                            },
                            "provider": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                            },
                            "id": {
                              "type": "string",
                              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                            }
                          },
                          "required": [
                            "source",
                            "provider",
                            "id"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "source": {
                              "type": "string",
                              "const": "file"
                            },
                            "provider": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                            },
                            "id": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "source",
                            "provider",
                            "id"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "source": {
                              "type": "string",
                              "const": "exec"
                            },
                            "provider": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                            },
                            "id": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "source",
                            "provider",
                            "id"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  ]
                },
                "mailbox": {
                  "type": "string",
                  "minLength": 1
                },
                "baseUrl": {
                  "type": "string",
                  "format": "uri"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "channel",
                    "notify",
                    "tool"
                  ]
                },
                "dmPolicy": {
                  "type": "string",
                  "enum": [
                    "allowlist",
                    "open",
                    "disabled"
                  ]
                },
                "allowFrom": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "defaultAccount": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "uiHints": {
        "apiKey": {
          "label": "API key",
          "sensitive": true
        },
        "mailbox": {
          "label": "Mailbox",
          "help": "The agent's address, or its mbx_ id"
        },
        "baseUrl": {
          "label": "API base URL",
          "advanced": true
        },
        "mode": {
          "label": "Mode",
          "help": "channel (default): mail from people wakes the agent and it replies in the thread; automated mail such as sign-up codes is passed to the agent in its main chat. notify: the agent tells you about new mail and sends nothing by itself. tool: nothing inbound; email only when you ask."
        },
        "dmPolicy": {
          "label": "Who can reach the agent",
          "help": "allowlist (default): only senders in allowFrom start a conversation with the agent. open: anyone (needs \"*\" in allowFrom). disabled: nobody. Mail from everyone else, like sign-up codes, still reaches the main chat as a short note."
        },
        "allowFrom": {
          "label": "Allowed senders",
          "help": "Addresses or @domain entries, e.g. you@example.com or @yourcompany.com"
        }
      }
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "channels.groundmail.apiKey",
          "expected": "string"
        },
        {
          "path": "channels.groundmail.accounts.*.apiKey",
          "expected": "string"
        }
      ]
    }
  },
  "skills": [
    "skills"
  ],
  "cliCommands": [
    {
      "name": "groundmail",
      "description": "Groundmail CLI with this channel's mailbox key",
      "hasSubcommands": false
    }
  ]
}
